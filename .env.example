# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun. `.env` gitignore'dadır (docs/security.md).
POSTGRES_DB=egitimyonetim
POSTGRES_USER=egitim
POSTGRES_PASSWORD=degistir-beni
POSTGRES_PORT=5432

# API bu bağlantı dizesini ortam değişkeninden okur; appsettings dosyalarında sır tutulmaz.
ConnectionStrings__Database=Host=localhost;Port=5432;Database=egitimyonetim;Username=egitim;Password=degistir-beni

# JWT imzalama anahtarı (yalnızca yerel geliştirme için üretilmiş bir değer koyun; paylaşmayın).
Jwt__SigningKey=

# İlk eğitim sorumlusu (Admin) hesabı. Yalnızca veritabanında hiç hesap yokken kullanılır; hesap
# geçici şifre bayrağıyla açılır ve ilk girişte şifre değiştirilmek zorundadır.
SeedAdmin__Email=
SeedAdmin__Password=
